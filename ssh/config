# The Macs, over Tailscale (MagicDNS names, so a changed address doesn't
# matter). m4 is the Mac mini M4 (hostname "mini", the primary); m2 and
# mac-desktop are the older Mac mini M2 (NAS and job runner).
Host m4
    HostName mini.tail8aa7c8.ts.net
    User dawsonshay

Host m2 mac-desktop
    HostName dawsons-mac-mini.tail8aa7c8.ts.net
    User daws

# The MacBook Air (its tailnet name; check it after a reinstall, which may
# change the -2).
Host laptop
    HostName dawsons-macbook-air-2.tail8aa7c8.ts.net
    User daws

# One connection per host, reused for 10 minutes: Emacs TRAMP, git and repeat
# ssh commands skip the handshake.
Host m4 m2 mac-desktop laptop
    ControlMaster auto
    ControlPath ~/.ssh/cm-%r@%h:%p
    ControlPersist 10m
    ForwardAgent no
    # Notice within about 45 s that the other end has gone (sleep, a dropped
    # network), so a dead session ends instead of hanging.
    ServerAliveInterval 15
    ServerAliveCountMax 3
    # Tailscale authenticates the machines, so trust a host's key the first
    # time; a changed key is still refused.
    StrictHostKeyChecking accept-new
